DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cipd_ambassadors
JWT_SECRET=
PUBLIC_FRONTEND_URL=http://localhost:3000
EMAIL_DELIVERY_ENABLED=false
# Optional: only auto-send jobs queued at or after this timezone-aware timestamp.
# Older jobs remain queued until an admin explicitly chooses Send pending now.
EMAIL_AUTOSEND_AFTER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Instagram OAuth (Instagram API with Instagram Login).
# Create a Meta app at developers.facebook.com, add the "Instagram" product,
# and use "Business Login for Instagram" to get an App ID/Secret. Add each
# ambassador's Instagram account as a Tester in the App Dashboard while in
# Development Mode - this needs no app review for a small pilot group.
# Ambassadors must connect a Business or Creator Instagram account
# (personal accounts cannot use this login flow).
# Instagram requires an HTTPS redirect URI, so local development needs an HTTPS
# tunnel (for example ngrok) pointing at the backend on port 8000.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR-TUNNEL-DOMAIN/ambassador/social-accounts/instagram/callback
# Where the backend sends the browser after Instagram authorization
# (falls back to PUBLIC_FRONTEND_URL, then http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# Symmetric key used to encrypt social access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Per-post background refresh target; Meta throttling can defer attempts.
INSTAGRAM_SYNC_ENABLED=true
INSTAGRAM_SYNC_INTERVAL_MINUTES=60
INSTAGRAM_SYNC_BATCH_SIZE=20
# Conservative local safety budgets, not Meta's published app quota.
INSTAGRAM_API_APP_CALLS_PER_HOUR=180
INSTAGRAM_API_ACCOUNT_CALLS_PER_HOUR=60
INSTAGRAM_API_REQUEST_SPACING_MS=1000
INSTAGRAM_API_USAGE_THRESHOLD_PERCENT=70
