DATABASE_URL=postgresql://postgres:sudo@localhost:5432/cipd_ambassadors
JWT_SECRET=

# Instagram OAuth (Instagram API with Instagram Login).
# Create a Meta app at developers.facebook.com, add the "Instagram" product,
# and use "Business Login for Instagram" to get an App ID/Secret. Add each
# ambassador's Instagram account as a Tester in the App Dashboard while in
# Development Mode — this needs no app review for a small pilot group.
# Ambassadors must connect a Business or Creator Instagram account
# (personal accounts cannot use this login flow).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/ambassador/social-accounts/instagram/callback
FRONTEND_URL=http://localhost:3000

# Symmetric key used to encrypt social access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
